<link rel="stylesheet" href="../style/style_padrao.css">
<link rel="stylesheet" href="../style/style_home.css">  
  <!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />  




  <nav class="navbar">
    <div class="container-fluid">
      <!-- ESQUERDA -->
      <div class="d-flex align-items-center gap-3">
        <div id="menu-container">
          <button class="btn border-0">
            <i class="bi bi-list fs-2"></i>
          </button>

          <div id="blur"></div>

          <!-- SIDEBAR -->
          <div id="sidebar">
            <a href="perfil.html" class="d-block text-decoration-none py-2">
              <i class="bi bi-person-circle"></i>
              Perfil
            </a>

            <a href="serie.html" class="d-block text-decoration-none py-2">
              <i class="bi bi-tv"></i>
              Série
            </a>

            <a href="filme.html" class="d-block text-decoration-none py-2">
              <i class="bi bi-camera-video"></i>
              Filme
            </a>

            <a href="ator.html" class="d-block text-decoration-none py-2">
              <i class="bi bi-person-badge"></i>
              Ator
            </a>

            <a href="sobre.html" target="_blank" class="d-block text-decoration-none py-2">
              <i class="bi bi-question-circle"></i>
              Sobre
            </a>
          </div>
        </div>

        <h1 class="fs-3 m-0">SoulGeek</h1>
      </div>

      <!-- DIREITA -->
      <div class="d-flex align-items-center gap-3">
        <div id="areaUsuario" class="d-flex align-items-center gap-3">
          <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#Login"
            data-whatever="@getbootstrap">
            Entrar
          </button>

          <div class="modal fade" id="Login" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Entrar no SoulGeek
                  </h5>

                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Email</label>

                    <input type="email" class="form-control" id="loginEmail" placeholder="Digite seu email" />
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Senha</label>

                    <input type="password" class="form-control" id="loginSenha" placeholder="Digite sua senha" />
                  </div>
                  <div class="text-center mt-3">
                    Não possui uma conta?
                    <a href="#" id="abrirCadastro" class="modal-link">Cadastre-se</a>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn w-100" id="btnLogin">
                    Entrar
                  </button>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="btn text-nowrap" data-bs-toggle="modal" data-bs-target="#SignIn"
            data-whatever="@getbootstrap">
            Cadastrar
          </button>

          <div class="modal fade" id="SignIn" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">
                    <i class="bi bi-person-plus"></i>
                    Criar Conta
                  </h5>

                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Nome</label>

                    <input type="text" class="form-control" id="cadastroNome" placeholder="Digite seu nome" />
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Email</label>

                    <input type="email" class="form-control" id="cadastroEmail" placeholder="Digite seu email" />
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Senha</label>

                    <input type="password" class="form-control" id="cadastroSenha" placeholder="Crie uma senha" />
                  </div>

                  <div class="mb-3">
                    <label class="form-label">Confirmar Senha</label>

                    <input type="password" class="form-control" id="cadastroConfirmacaoSenha"
                      placeholder="Confirme sua senha" />
                  </div>

                  <div class="text-center mt-3">
                    Já possui uma conta?
                    <a href="#" id="abrirLogin" class="modal-link">Entrar</a>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn w-100" id="btnCadastro">
                    Criar Conta
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>


      </div>
    </div>
  </nav>
