<%- include('partes/header_padrao')%> 

  <main class="flex-grow-1">
    <div class="container mt-5">
      <div class="row">
        <div class="col-md-4">
          <img id="imagem" class="img-fluid" />
        </div>

        <div class="col-md-8">
          <div id="info">
            <h3 id="generos"></h3>
            <h1 id="titulo"></h1>
          </div>

          <p id="descricao"></p>

          <div id="interacoesUsuario">
            <div class="mt-4">
              <button id="btnLike" class="btn btn-danger">
                <i class="bi bi-heart-fill"></i>
                Curtir
              </button>

              <button id="btnWatchlist" class="btn btn-warning">
                <i class="bi bi-bookmark-fill"></i>
                Watchlist
              </button>
            </div>

            <div class="mt-4">
              <h4>Sua nota</h4>
              <p id="notaExibida"></p>

              ⭐⭐⭐⭐⭐
            </div>
            <select id="notaUsuario" class="form-select">
              <option value="0">0</option>
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
            <button id="btnSalvarNota" class="btn btn-primary">
              Salvar Nota
            </button>
          </div>


        </div>
      </div>
    </div>
    <section id="Sombra">
      <input type="checkbox" id="btnClaroEscuro" />
      <label for="btnClaroEscuro" class="slider">
        <div id="fundo" class="btn btn-dark">
          <i id="Sol" class="bi bi-brightness-high-fill"></i>
          <i id="Lua" class="bi bi-moon-stars-fill"></i>
        </div>
      </label>
    </section>
  </main>

<%- include('partes/footer')%>
