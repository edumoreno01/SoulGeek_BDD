<%- include('partes/header_padrao')%> 

<main class="flex-grow-1">
    <section id="carousel">
      <div id="carouselFilmes" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="../views/img/Cenas/Como_eu_era_antes_de_voce.jpg" class="d-block w-100 img-como" />
          </div>

          <div class="carousel-item">
            <img src="../views/img/Cenas/Homem_aranha.jpg" class="d-block w-100 img-diabo" />
          </div>

          <div class="carousel-item">
            <img src="../views/Img/Cenas/La_La_Land.jpg" class="d-block w-100 img-lalaland" />
          </div>

          <div class="carousel-item">
            <img src="../views/Img/Cenas/Homem_Aranha.jpg" class="d-block w-100 img-homem" />
          </div>
        </div>
      </div>
    </section>

    <div class="container text-center my-5">
      <h1 class="display-4">Descubra filmes e séries incríveis</h1>
      <p class="lead">
        Avalie, compartilhe opiniões e encontre recomendações.
      </p>
      <button id="btnComecarAgora" type="button" class="btn btn-success text-nowrap" data-bs-toggle="modal"
        data-bs-target="#SignIn" data-whatever="@getbootstrap">
        Começar Agora
      </button>
    </div>

    <!-- FILMES -->
    <section id="movies" class="container my-5">
      <h2 class="mb-4">Filmes Populares</h2>

      <div class="row g-4">
        <!-- FILME 1 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Interestelar.jpg" class="img-fluid" />

            <div class="media-title">Interestelar</div>
          </a>
        </div>

        <!-- FILME 2 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Anyone.webp" class="img-fluid" />

            <div class="media-title">Todos Menos Você</div>
          </a>
        </div>

        <!-- FILME 3 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Brokeback.webp" class="img-fluid" />

            <div class="media-title">Brokeback Mountain</div>
          </a>
        </div>

        <!-- FILME 4 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Titanic.webp" class="img-fluid" />

            <div class="media-title">Titanic</div>
          </a>
        </div>

        <!-- FILME 5 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Whiplash.jpg" class="img-fluid" />

            <div class="media-title">Whiplash</div>
          </a>
        </div>

        <!-- FILME 6 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="filme.html" class="media-card">
            <img src="../Assets/Img/Poster/Movies/Matrix.webp" class="img-fluid" />

            <div class="media-title">Matrix</div>
          </a>
        </div>
      </div>
    </section>

    <!-- SÉRIES -->
    <section id="series" class="container my-5">
      <h2 class="mb-4">Séries Populares</h2>

      <div class="row g-4">
        <!-- SÉRIE 1 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/Breaking.jpg" class="img-fluid" />

            <div class="media-title">Breaking Bad</div>
          </a>
        </div>

        <!-- SÉRIE 2 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/Stranger.jpg" class="img-fluid" />

            <div class="media-title">Stranger Things</div>
          </a>
        </div>

        <!-- SÉRIE 3 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/dark.jpg" class="img-fluid" />

            <div class="media-title">Dark</div>
          </a>
        </div>

        <!-- SÉRIE 4 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/Game.jpg" class="img-fluid" />

            <div class="media-title">Game of Thrones</div>
          </a>
        </div>

        <!-- SÉRIE 5 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/Last.webp" class="img-fluid" />

            <div class="media-title">The Last of Us</div>
          </a>
        </div>

        <!-- SÉRIE 6 -->
        <div class="col-6 col-md-4 col-lg-2">
          <a href="serie.html" class="media-card">
            <img src="../Assets/Img/Poster/Series/office.jpg" class="img-fluid" />
            <div class="media-title">The Office</div>
          </a>
        </div>
      </div>
    </section>

    <!-- SOBRE -->
    <section id="sobre" class="container my-5">
      <p class="text-secondary small">SOUL GEEK PERMITE QUE VOCÊ...</p>
      <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-eye-fill fs-1"></i>
              <p class="mb-0">
                Acompanhe todos os filmes que você já assistiu.
              </p>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-heart-fill fs-1"></i>
              <p class="mb-0">Favorite seus filmes e séries preferidos.</p>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-chat-left-text-fill fs-1"></i>
              <p class="mb-0">Escreva reviews e compartilhe opiniões.</p>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-star-fill fs-1"></i>
              <p class="mb-0">
                Avalie filmes e séries usando notas de 1 a 5 estrelas.
              </p>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-calendar-event-fill fs-1"></i>
              <p class="mb-0">
                Mantenha um histórico dos filmes e séries que assistiu.
              </p>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100">
            <div class="card-body d-flex gap-3">
              <i class="bi bi-grid-fill fs-1"></i>
              <p class="mb-0">
                Crie listas personalizadas dos seus filmes favoritos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="Sombra">
      <input type="checkbox" id="btnClaroEscuro" />
      <label for="btnClaroEscuro" class="slider">
        <div id="fundo" class="btn btn-dark">
          <i id="Sol" class="bi bi-brightness-high-fill"></i>
          <i id="Lua" class="bi bi-moon-stars-fill"></i>
        </div>
      </label>
    </section>
  </main>

<%- include('partes/footer')%>
